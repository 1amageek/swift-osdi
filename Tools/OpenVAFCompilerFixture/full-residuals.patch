+#[cfg(test)]
+mod tests {
+    use super::*;
+    use hir::diagnostics::ConsoleSink;
+
+    fn records(bytes: &[u8], width: usize) -> Vec<Vec<u32>> {
+        bytes.chunks_exact(width * 4).map(|record| record.chunks_exact(4)
+            .map(|word|u32::from_le_bytes(word.try_into().unwrap())).collect()).collect()
+    }
+
+    #[test]
+    fn analysis_fact_preserves_integer_arithmetic_and_condition_consumers() {
+        let db=CompilationDB::new_virtual(r#"
+            `include "disciplines.vams"
+            module precision_analysis(inout p);
+            electrical p;
+            analog I(p)<+(analysis("ic") ? 2.0 : 3.0)+4.0*analysis("ic");
+            endmodule
+        "#).unwrap();
+        let module=sim_back::collect_modules(&db,false,&mut ConsoleSink::new(&db)).unwrap().remove(0);
+        let mut literals=Rodeo::new();
+        let precise=PrecisionModule::new(&db,&module,&mut literals);
+        let mut serializer=Serializer { tables:Tables::default(),db:&db,literals:&literals,
+            parameter_ids:HashMap::new(),raw_nodes:HashMap::new(),model_roots:HashMap::new(),
+            instance_roots:HashMap::new(),builtin_parameters:HashMap::new() };
+        serializer.builtin_parameters.insert(hir::ParamSysFun::mfactor,0);
+        for (index,&node) in precise.dae.unknowns.iter_enumerated() {
+            serializer.raw_nodes.insert(node,index.into());
+        }
+        let roots:Vec<_>=precise.dae.residual.iter_enumerated()
+            .map(|(index,r)|(1,r.resist,index.into(),NONE)).collect();
+        serializer.function(3,&precise.evaluate,&roots).unwrap();
+        let types=records(&serializer.tables.registers,2);
+        let instructions=records(&serializer.tables.instructions,6);
+        let inputs=records(&serializer.tables.inputs,6);
+        assert!(inputs.iter().any(|input|input[2]==9));
+        for input in inputs.iter().filter(|input|input[2]==9) {
+            assert_eq!(types[input[1] as usize][0],3,"analysis fact must remain Boolean");
+        }
+        let mut integer_condition=false;
+        let mut integer_arithmetic=false;
+        for instruction in instructions {
+            match instruction[0] {
+                9 => { // IBCAST consumes the source callback's I32 result.
+                    assert_eq!(types[instruction[2] as usize][0],2,"source analysis condition lost I32");
+                    assert_eq!(types[instruction[1] as usize][0],3);
+                    integer_condition=true;
+                }
+                7 => { // IFCAST consumes the same source I32 type in arithmetic.
+                    assert_eq!(types[instruction[2] as usize][0],2,"source analysis arithmetic lost I32");
+                    assert_eq!(types[instruction[1] as usize][0],1);
+                    integer_arithmetic=true;
+                }
+                8 => {
+                    assert_eq!(types[instruction[2] as usize][0],3);
+                    assert_eq!(types[instruction[1] as usize][0],2);
+                }
+                _=>{}
+            }
+        }
+        assert!(integer_condition && integer_arithmetic);
+    }
+}
