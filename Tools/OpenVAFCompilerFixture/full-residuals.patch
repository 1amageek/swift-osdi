@@ -0,0 +1,256 @@
+//! Source-faithful precision IR, kept separate from the binary64 optimization lane.
+use hir::{BranchWrite, CompilationDB};
+use hir_lower::{HirInterner, CallBackKind, PlaceKind};
+use mir_build::SSAVariableBuilder;
+use mir::{ControlFlowGraph, InstructionData, Value, FALSE, TRUE};
+use crate::SimUnknownKind;
+use lasso::Rodeo;
+use mir::Function;
+use crate::{context::Context, dae::DaeSystem, topology::Topology, ModuleInfo};
+
+pub struct PrecisionFunction {
+    pub function: Function,
+    pub interner: HirInterner,
+}
+
+pub struct PrecisionModule {
+    pub model_setup: PrecisionFunction,
+    pub instance_setup: PrecisionFunction,
+    pub evaluate: PrecisionFunction,
+    pub dae: DaeSystem,
+    pub collapse: Vec<(SimUnknownKind, Option<SimUnknownKind>, Value)>,
+}
+
+impl PrecisionModule {
+    pub fn new(db: &CompilationDB, module: &ModuleInfo, literals: &mut Rodeo) -> Self {
+        let mut context = Context::new_with_precision(db, literals, module, true);
+        context.prepare_precision_topology();
+        let topology = Topology::new(&mut context, true);
+        let dae = DaeSystem::new(&mut context, topology);
+        context.retain_preparation_collapse();
+        mir_opt::dead_code_elimination(&mut context.func, &context.output_values);
+        let mut cfg = ControlFlowGraph::new();
+        cfg.compute(&context.func);
+        let calls: Vec<_> = context.func.layout.blocks().flat_map(|block|
+            context.func.layout.block_insts(block)).filter_map(|inst| {
+            if let InstructionData::Call { func_ref, .. } = context.func.dfg.insts[inst] {
+                if let CallBackKind::CollapseHint(hi, lo) = context.intern.callbacks[func_ref] {
+                    return Some((hi, lo, inst));
+                }
+            }
+            None
+        }).collect();
+        let mut collapse = Vec::new();
+        let mut ssa = SSAVariableBuilder::new(&cfg);
+        for (hi, lo, inst) in calls {
+            let guard = ssa.define_at_exit(&mut context.func, FALSE, TRUE, inst);
+            collapse.push((SimUnknownKind::KirchoffLaw(hi),
+                lo.map(SimUnknownKind::KirchoffLaw), guard));
+        }
+        // Match NodeCollapse::new's source-owned implication: a collapsed voltage
+        // branch also removes its auxiliary current equation. This is topology,
+        // never a numerical inference from zero F/G values.
+        for (hi, lo, guard) in collapse.clone() {
+            for &kind in dae.unknowns.iter() {
+                if let SimUnknownKind::Current(current) = kind {
+                    if let Ok(branch) = BranchWrite::try_from(current) {
+                        let (a, b) = branch.nodes(db);
+                        let a = SimUnknownKind::KirchoffLaw(a);
+                        let b = b.map(SimUnknownKind::KirchoffLaw);
+                        if (hi == a && lo == b) || (Some(hi) == b && lo == Some(a)) {
+                            collapse.push((kind, None, guard));
+                        }
+                    }
+                }
+            }
+        }
+        for (&kind, value) in &context.intern.outputs {
+            if let PlaceKind::CollapseImplicitEquation(eq) = kind {
+                if let Some(value) = value.expand() {
+                    collapse.push((SimUnknownKind::Implicit(eq), None, value));
+                }
+            }
+        }
+        let mut model_setup = PrecisionFunction {
+            function: Function::default(), interner: HirInterner::default(),
+        };
+        model_setup.interner.precision_semantics = true;
+        let parameters: Vec<_> = module.params.keys().copied().collect();
+        model_setup.interner.insert_param_init(db, &mut model_setup.function,
+            literals, true, false, &parameters);
+        let mut instance_setup = PrecisionFunction {
+            function: Function::default(), interner: HirInterner::default(),
+        };
+        instance_setup.interner.precision_semantics = true;
+        let parameters: Vec<_> = module.params.iter()
+            .filter_map(|(parameter, info)| info.is_instance.then_some(*parameter)).collect();
+        instance_setup.interner.insert_param_init(db, &mut instance_setup.function,
+            literals, true, false, &parameters);
+        for setup in [&mut model_setup, &mut instance_setup] {
+            let mut roots = bitset::BitSet::new_empty(setup.function.dfg.num_values());
+            for value in setup.interner.outputs.values().filter_map(|v| v.expand()) { roots.insert(value); }
+            mir_opt::dead_code_elimination(&mut setup.function, &roots);
+        }
+        // Keep every source output and callback here. The serializer performs only
+        // graph liveness, never arithmetic folding or import of native cache values.
+        Self {
+            model_setup, instance_setup,
+            evaluate: PrecisionFunction { function: context.func, interner: context.intern },
+            dae, collapse,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use hir_lower::PlaceKind;
+    use hir::diagnostics::ConsoleSink;
+    fn compile(source:&str)->(PrecisionModule,Rodeo) {
+        let db=CompilationDB::new_virtual(source).unwrap();
+        let module=crate::collect_modules(&db,false,&mut ConsoleSink::new(&db)).unwrap().remove(0);
+        let mut strings=Rodeo::new();
+        let precise=PrecisionModule::new(&db,&module,&mut strings);
+        assert!(precise.model_setup.function.validate());
+        assert!(precise.instance_setup.function.validate());
+        assert!(precise.evaluate.function.validate());
+        (precise,strings)
+    }
+    #[test]
+    fn precision_conditional_literal_shorts_keep_source_residual_natures() {
+        let source=r#"
+            `include "disciplines.vams"
+            module precision_natures(inout p, inout t);
+            electrical p;
+            thermal t;
+            parameter integer enabled=1;
+            analog begin
+                if (enabled!=0) begin
+                    V(p)<+0;
+                    Temp(t)<+0;
+                end else begin
+                    I(p)<+V(p)*0.003;
+                    Pwr(t)<+Temp(t)*0.004;
+                end
+            end
+            endmodule
+        "#;
+        let db=CompilationDB::new_virtual(source).unwrap();
+        let module=crate::collect_modules(&db,false,&mut ConsoleSink::new(&db)).unwrap().remove(0);
+        let mut strings=Rodeo::new();
+        let precise=PrecisionModule::new(&db,&module,&mut strings);
+        let native=crate::CompiledModule::new_with_precision(&db,&module,&mut strings,false,false,true,true);
+        assert_eq!(precise.dae.unknowns.len(),2,"primitive zero shorts generated mixed-nature auxiliary rows");
+        assert_eq!(native.dae_system.unknowns.len(),2,"native primitive zero shorts generated mixed-nature auxiliary rows");
+        for dae in [&precise.dae,&native.dae_system] {
+            assert!(dae.residual.iter().all(|r|r.nature_kind==crate::dae::ResidualNatureKind::Flow));
+        }
+    }
+
+    #[test]
+    fn precision_collapse_uses_native_preparation_value_and_control_taint() {
+        for condition in ["V(p)>0", "$abstime>0", "analysis(\"tran\")"] {
+            let source = format!(r#"
+                `include "disciplines.vams"
+                module precision_dynamic_collapse(inout p, inout n);
+                electrical p,n,x;
+                analog begin
+                    if ({condition}) V(x,n)<+0;
+                    else I(x,n)<+V(x,n);
+                    I(p,x)<+V(p,x);
+                end
+                endmodule
+            "#);
+            let db=CompilationDB::new_virtual(&source).unwrap();
+            let module=crate::collect_modules(&db,false,&mut ConsoleSink::new(&db)).unwrap().remove(0);
+            let mut strings=Rodeo::new();
+            let precise=PrecisionModule::new(&db,&module,&mut strings);
+            let native=crate::CompiledModule::new_with_precision(&db,&module,&mut strings,false,false,true,true);
+            assert!(precise.collapse.is_empty(), "dynamic guard admitted: {condition}");
+            assert_eq!(native.node_collapse.num_pairs(),0,"native dynamic guard admitted: {condition}");
+        }
+        let (module,_) = compile(r#"
+            `include "disciplines.vams"
+            module precision_static_collapse(inout p, inout n);
+            electrical p,n,x;
+            parameter integer shorted=1;
+            analog begin
+                if (shorted!=0) V(x,n)<+0;
+                else I(x,n)<+V(x,n);
+                I(p,x)<+V(p,x);
+            end
+            endmodule
+        "#);
+        assert!(!module.collapse.is_empty(),"preparation parameter guard lost");
+    }
+
+    #[test]
+    fn precision_image_and_program_share_prefold_coordinate_axes() {
+        let source=r#"
+            `include "disciplines.vams"
+            module precision_axes(inout p, inout n);
+            electrical p,n,x;
+            parameter integer mode=1;
+            analog begin
+                if (mode!=0) V(x,n)<+0;
+                else I(x,n)<+V(x,n);
+                I(p,x)<+V(p,x)*V(p,x)+ddt(V(p,x)*1e-9);
+            end
+            endmodule
+        "#;
+        let db=CompilationDB::new_virtual(source).unwrap();
+        let module=crate::collect_modules(&db,false,&mut ConsoleSink::new(&db)).unwrap().remove(0);
+        let mut strings=Rodeo::new();
+        let precise=PrecisionModule::new(&db,&module,&mut strings);
+        let native=crate::CompiledModule::new_with_precision(&db,&module,&mut strings,false,false,true,true);
+        assert!(precise.dae.unknowns.iter().eq(native.dae_system.unknowns.iter()));
+    }
+
+    #[test]
+    fn precision_preserves_compound_default_and_source_arithmetic() {
+        let (module,strings)=compile(r#"
+            `include "disciplines.vams"
+            module precision_compound(inout p);
+            electrical p;
+            parameter real k=10000000000000000.0+1.0;
+            analog I(p)<+(k-10000000000000000.0)+V(p)*V(p);
+            endmodule
+        "#);
+        let setup=module.model_setup.function.print(&strings).to_string();
+        assert!(setup.contains("fadd"),"{setup}");
+        let eval=module.evaluate.function.print(&strings).to_string();
+        assert!(eval.contains("fmul"),"{eval}");
+        assert!(eval.contains("fsub"),"{eval}");
+    }
+    #[test]
+    fn precision_expands_builtin_compound_constants() {
+        let (module,strings)=compile(r#"
+            `include "disciplines.vams"
+            module precision_builtin(inout p);
+            electrical p;
+            analog I(p)<+limexp(V(p))+$vt(300.0);
+            endmodule
+        "#);
+        let eval=module.evaluate.function.print(&strings).to_string();
+        assert!(eval.contains("ln"),"{eval}");
+        assert!(eval.contains("fdiv"),"{eval}");
+    }
+    #[test]
+    fn precision_keeps_model_and_instance_default_phi_outputs() {
+        let (module,strings)=compile(r#"
+            `include "disciplines.vams"
+            module precision_defaults(inout p);
+            electrical p;
+            (* type="instance" *) parameter real l=2.0;
+            (* type="instance" *) parameter real w=3.0*l;
+            analog I(p)<+w*V(p);
+            endmodule
+        "#);
+        for setup in [&module.model_setup,&module.instance_setup] {
+            let text=setup.function.print(&strings).to_string();
+            assert!(text.contains("phi"),"{text}");
+            assert!(text.contains("fmul"),"{text}");
+            assert!(setup.interner.outputs.iter().filter(|(k,_)|matches!(k,PlaceKind::Param(_))).count()>=2);
+        }
+    }
+}
