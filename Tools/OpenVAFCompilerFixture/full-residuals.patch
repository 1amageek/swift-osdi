+        branch.current_src.resist_small_signal == mir::F_ZERO
+            && branch.current_src.react_small_signal == mir::F_ZERO
+    }));
+    assert!(full.branches().any(|(_, (_, branch))| {
+        branch.current_src.resist != mir::F_ZERO && branch.current_src.react != mir::F_ZERO
+    }));
