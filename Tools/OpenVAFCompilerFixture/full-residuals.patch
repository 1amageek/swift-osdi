new file mode 100644
index 0000000..47c0532
--- /dev/null
+++ b/openvaf/osdi/src/precision.rs
@@ -0,0 +1,450 @@
+//! Independent, pointer-free source precision program serialization.
+use std::collections::{HashMap, HashSet};
+use hir::{CompilationDB, Parameter, Type};
+use hir_lower::{CallBackKind, HirInterner, ParamKind, PlaceKind};
+use lasso::Rodeo;
+use mir::{Block, Const, Function, InstructionData, Opcode, Value, ValueDef};
+use sim_back::{precision::{PrecisionFunction, PrecisionModule}, SimUnknownKind};
+use crate::{compilation_unit::OsdiCompilationUnit, inst_data::OsdiInstanceParam};
+const NONE: u32 = u32::MAX;
+const HEADER_BYTES: usize = 248;
+
+fn words(values: &[u32]) -> Vec<u8> {
+    values.iter().flat_map(|v| v.to_le_bytes()).collect()
+}
+fn type_id(ty: &Type) -> Result<u32, String> {
+    match ty { Type::Real => Ok(1), Type::Integer => Ok(2), Type::Bool => Ok(3),
+        Type::String => Ok(4), _ => Err(format!("precision: unsupported type {ty:?}")) }
+}
+
+#[derive(Default)]
+struct Tables {
+    registers: Vec<u8>, constants: Vec<u8>, inputs: Vec<u8>, functions: Vec<u8>,
+    blocks: Vec<u8>, instructions: Vec<u8>, phi_edges: Vec<u8>, roots: Vec<u8>,
+    parameters: Vec<u8>, nodes: Vec<u8>, strings: Vec<u8>,
+}
+impl Tables {
+    fn string(&mut self, value: &str) -> (u32, u32) {
+        let offset = self.strings.len() as u32;
+        self.strings.extend_from_slice(value.as_bytes());
+        (offset, value.len() as u32)
+    }
+    fn root(&mut self, function: u32, kind: u32, value: u32, row: u32, col: u32) -> u32 {
+        let id = self.roots.len() as u32 / 24;
+        self.roots.extend(words(&[function, kind, value, row, col, 0])); id
+    }
+    fn input(&mut self, function: u32, destination: u32, kind: u32, index: u32, aux: u32) {
+        self.inputs.extend(words(&[function, destination, kind, index, aux, 0]));
+    }
+    fn register(&mut self, ty: u32) -> u32 {
+        let result = self.registers.len() as u32 / 8;
+        self.registers.extend(words(&[ty, 0])); result
+    }
+    fn finish(self, descriptor: u32, nodes: u32, profile: [u8; 32]) -> Result<Vec<u8>, String> {
+        let mut output = Vec::new();
+        output.extend_from_slice(b"OSDIPR1\0");
+        output.extend(words(&[1, HEADER_BYTES as u32]));
+        output.extend_from_slice(&0u64.to_le_bytes());
+        output.extend(words(&[1, descriptor, nodes, 0]));
+        output.extend_from_slice(&profile);
+        let sections = [(&self.registers,8),(&self.constants,16),(&self.inputs,24),
+            (&self.functions,24),(&self.blocks,40),(&self.instructions,24),
+            (&self.phi_edges,16),(&self.roots,24),(&self.parameters,32),
+            (&self.nodes,16),(&self.strings,1)];
+        let mut offset = HEADER_BYTES as u64;
+        for (bytes, stride) in sections {
+            if bytes.len() % stride != 0 || bytes.len()/stride > u32::MAX as usize {
+                return Err("precision: table geometry overflow".into());
+            }
+            output.extend_from_slice(&offset.to_le_bytes());
+            output.extend(words(&[(bytes.len()/stride) as u32, stride as u32]));
+            offset = offset.checked_add(bytes.len() as u64)
+                .ok_or("precision: program byte count overflow")?;
+            offset = (offset + 7) & !7;
+        }
+        assert_eq!(output.len(), HEADER_BYTES);
+        for (bytes, _) in sections {
+            output.extend(bytes);
+            while output.len() % 8 != 0 { output.push(0); }
+        }
+        let count = output.len() as u64;
+        output[16..24].copy_from_slice(&count.to_le_bytes());
+        Ok(output)
+    }
+}
+
+struct Serializer<'a, 'db> {
+    tables: Tables,
+    db: &'db CompilationDB,
+    literals: &'a Rodeo,
+    parameter_ids: HashMap<(Parameter, u32), u32>,
+    raw_nodes: HashMap<SimUnknownKind, u32>,
+    model_roots: HashMap<Parameter, u32>,
+    instance_roots: HashMap<Parameter, u32>,
+    builtin_parameters: HashMap<hir::ParamSysFun, u32>,
+}
+
+impl Serializer<'_, '_> {
+    fn parameter(&self, parameter: Parameter, stage: u32) -> Result<u32, String> {
+        let scope = if stage == 1 { 1 } else if self.parameter_ids.contains_key(&(parameter,2)) { 2 } else { 1 };
+        self.parameter_ids.get(&(parameter,scope)).copied()
+            .ok_or_else(|| format!("precision: missing parameter {}", parameter.name(self.db)))
+    }
+    fn prior(&self, parameter: Parameter, stage: u32) -> Option<u32> {
+        if stage == 2 { self.model_roots.get(&parameter).copied() }
+        else { self.instance_roots.get(&parameter).or_else(|| self.model_roots.get(&parameter)).copied() }
+    }
+    fn node(&self, node: SimUnknownKind) -> Result<u32, String> {
+        self.raw_nodes.get(&node).copied().ok_or_else(|| format!("precision: unmapped node {node:?}"))
+    }
+    fn param_type(&self, kind: ParamKind) -> Result<u32, String> {
+        match kind { ParamKind::Param(parameter) => type_id(&parameter.ty(self.db)),
+            ParamKind::ParamGiven{..}|ParamKind::PortConnected{..}|ParamKind::EnableIntegration|ParamKind::EnableLim => Ok(3),
+            ParamKind::Abstime|ParamKind::Temperature|ParamKind::Voltage{..}|ParamKind::Current(_)|ParamKind::ImplicitUnknown(_)|ParamKind::ParamSysFun(_) => Ok(1),
+            _ => Err(format!("precision: stateful input {kind:?} unsupported in v1")) }
+    }
+    fn bind_param(&mut self, function: u32, stage: u32, dst: u32, kind: ParamKind) -> Result<(), String> {
+        match kind {
+            ParamKind::Param(parameter) => {
+                if stage == 3 {
+                    let prior = self.prior(parameter, stage).ok_or("precision: unresolved eval parameter")?;
+                    self.tables.input(function,dst,11,prior,0);
+                } else {
+                    let id = self.parameter(parameter, stage)?;
+                    let prior = if stage == 2 { self.prior(parameter,stage).unwrap_or(NONE) } else { NONE };
+                    self.tables.input(function,dst,1,id,prior);
+                }
+            }
+            ParamKind::ParamGiven{param} => { let id=self.parameter(param,stage)?; self.tables.input(function,dst,2,id,0); }
+            ParamKind::Temperature => self.tables.input(function,dst,3,0,0),
+            ParamKind::Abstime => self.tables.input(function,dst,4,0,0),
+            ParamKind::EnableIntegration => self.tables.input(function,dst,5,0,0),
+            ParamKind::EnableLim => self.tables.input(function,dst,6,0,0),
+            ParamKind::PortConnected{port} => {
+                let index=self.node(SimUnknownKind::KirchoffLaw(port))?;
+                self.tables.input(function,dst,7,index,0);
+            }
+            ParamKind::Voltage{hi,lo} => {
+                let hi=self.node(SimUnknownKind::KirchoffLaw(hi))?;
+                let lo=lo.map(|n|self.node(SimUnknownKind::KirchoffLaw(n))).transpose()?.unwrap_or(NONE);
+                self.tables.input(function,dst,10,hi,lo);
+            }
+            ParamKind::Current(current) => { let n=self.node(SimUnknownKind::Current(current))?; self.tables.input(function,dst,10,n,NONE); }
+            ParamKind::ImplicitUnknown(eq) => { let n=self.node(SimUnknownKind::Implicit(eq))?; self.tables.input(function,dst,10,n,NONE); }
+            ParamKind::ParamSysFun(kind) => {
+                let id=*self.builtin_parameters.get(&kind).ok_or("precision: missing built-in parameter")?;
+                self.tables.input(function,dst,1,if stage==1 {id-1}else{id},NONE);
+            }
+            _ => return Err(format!("precision: unsupported stateful input {kind:?}")),
+        }
+        Ok(())
+    }
+    fn function(&mut self, stage: u32, source: &PrecisionFunction,
+        roots: &[(u32,Value,u32,u32)]) -> Result<(), String> {
+        let function = &source.function;
+        let interner = &source.interner;
+        let function_id = stage-1;
+        let register_base=self.tables.registers.len() as u32/8;
+        let mut live=HashSet::new();
+        for block in function.layout.blocks() {
+            for inst in function.layout.block_insts(block) {
+                live.extend(function.dfg.inst_results(inst).iter().copied());
+                live.extend(function.dfg.instr_args(inst).iter().copied());
+            }
+        }
+        live.extend(roots.iter().map(|root|root.1));
+        let values:Vec<_>=function.dfg.values().filter(|v|live.contains(v)).collect();
+        let registers:HashMap<_,_>=values.iter().enumerate().map(|(i,&v)|(v,register_base+i as u32)).collect();
+        let mut types=vec![0;function.dfg.num_values()];
+        for &value in &values {
+            let ty=match function.dfg.value_def(value) {
+                ValueDef::Const(Const::Float(_))=>1, ValueDef::Const(Const::Int(_))=>2,
+                ValueDef::Const(Const::Bool(_))=>3, ValueDef::Const(Const::Str(_))=>4,
+                ValueDef::Param(p)=>if function.dfg.value_dead(value) {1} else {self.param_type(*interner.params.get_index(p).ok_or("precision: unbound parameter")?.0)?},
+                ValueDef::Result(inst,_)=> {
+                    let op=function.dfg.insts[inst].opcode() as u8;
+                    match op { 1|4|5|6|8|19|34..=43=>2, 2|9|10|49..=64=>3,
+                        3|7|11|13..=18|20..=33|44..=48|65..=67=>1,
+                        71=>match &function.dfg.insts[inst] {
+                            InstructionData::Call{func_ref,..}=>match interner.callbacks[*func_ref] { CallBackKind::Analysis=>2, _=>1 }, _=>0 },
+                        _=>0 }
+                }, ValueDef::Invalid=>0,
+            };
+            types[usize::from(value)]=ty;
+        }
+        // Phi and optbarrier inherit their operand type; resolve cycles from typed incoming edges.
+        loop {
+            let mut changed=false;
+            for &value in &values {
+                if types[usize::from(value)]!=0 {continue;}
+                if let ValueDef::Result(inst,_) = function.dfg.value_def(value) {
+                    let ty=function.dfg.instr_args(inst).iter().map(|v|types[usize::from(*v)]).find(|&t|t!=0).unwrap_or(0);
+                    if ty!=0 {types[usize::from(value)]=ty;changed=true;}
+                }
+            }
+            if !changed {break;}
+        }
+        for &value in &values {
+            // Unused detached values are not consumed; a bool register is harmless storage.
+            self.tables.register(types[usize::from(value)].max(1));
+            let dst=registers[&value];
+            match function.dfg.value_def(value) {
+                ValueDef::Const(constant)=> {
+                    let (ty,bits)=match constant {Const::Float(v)=>(1,v.bits()),Const::Int(v)=>(2,v as i64 as u64),
+                        Const::Bool(v)=>(3,v as u64),Const::Str(v)=>{let (o,n)=self.tables.string(self.literals.resolve(&v));(4,((n as u64)<<32)|o as u64)}};
+                    self.tables.constants.extend(words(&[dst,ty]));self.tables.constants.extend(bits.to_le_bytes());
+                }
+                ValueDef::Param(p)=> { if !function.dfg.value_dead(value) {
+                    self.bind_param(function_id,stage,dst,*interner.params.get_index(p).ok_or("precision: missing parameter")?.0)?;
+                }}
+                _=>{}
+            }
+        }
+        let blocks:Vec<_>=function.layout.blocks().collect();
+        let block_base=self.tables.blocks.len() as u32/40;
+        let block_map:HashMap<Block,u32>=blocks.iter().enumerate().map(|(i,&b)|(b,block_base+i as u32)).collect();
+        self.tables.functions.extend(words(&[stage,block_map[&function.layout.entry_block().ok_or("precision: no entry block")?],block_base,blocks.len() as u32,0,0]));
+        for block in blocks {
+            let first_instruction=self.tables.instructions.len() as u32/24;
+            let first_phi=self.tables.phi_edges.len() as u32/16;
+            let mut term=[0,NONE,NONE,NONE];
+            for inst in function.layout.block_insts(block) {
+                let data=&function.dfg.insts[inst];
+                let dst=function.dfg.inst_results(inst).first().map(|v|registers[v]).unwrap_or(NONE);
+                match data {
+                    InstructionData::Branch{cond,then_dst,else_dst,..}=>term=[2,registers[cond],block_map[then_dst],block_map[else_dst]],
+                    InstructionData::Jump{destination}=>term=[1,NONE,block_map[destination],NONE],
+                    InstructionData::Exit=>term=[0,NONE,NONE,NONE],
+                    InstructionData::PhiNode(phi)=>for (pred,value) in function.dfg.phi_edges(phi) {
+                        self.tables.phi_edges.extend(words(&[dst,block_map[&pred],registers[&value],0]));
+                    },
+                    InstructionData::Call{func_ref,args}=> {
+                        let args=args.as_slice(&function.dfg.insts.value_lists);
+                        self.callback(function_id,stage,&registers,dst,&interner.callbacks[*func_ref],args,function)?;
+                    }
+                    _=> {
+                        let args=function.dfg.instr_args(inst);
+                        let a=args.first().map(|v|registers[v]).unwrap_or(NONE);
+                        let b=args.get(1).map(|v|registers[v]).unwrap_or(NONE);
+                        self.tables.instructions.extend(words(&[data.opcode() as u32,dst,a,b,NONE,0]));
+                    }
+                }
+            }
+            self.tables.blocks.extend(words(&[function_id,first_instruction,
+                self.tables.instructions.len() as u32/24-first_instruction,first_phi,
+                self.tables.phi_edges.len() as u32/16-first_phi,term[0],term[1],term[2],term[3],0]));
+        }
+        let mut collapse_roots = HashMap::new();
+        for &(kind,value,row,col) in roots {
+            let register = registers[&value];
+            if kind == 6 {
+                if let Some(&(root_id, previous)) = collapse_roots.get(&(row,col)) {
+                    let yes=self.tables.register(3);
+                    self.tables.constants.extend(words(&[yes,3]));
+                    self.tables.constants.extend(1u64.to_le_bytes());
+                    let merged=self.tables.register(3);
+                    self.tables.instructions.extend(words(&[74,merged,previous,yes,register,0]));
+                    let block_offset=self.tables.blocks.len()-40;
+                    if u32::from_le_bytes(self.tables.blocks[block_offset+20..block_offset+24].try_into().unwrap())!=0 {
+                        return Err("precision: collapse merge requires function exit block".into());
+                    }
+                    let count=u32::from_le_bytes(self.tables.blocks[block_offset+8..block_offset+12].try_into().unwrap())+1;
+                    self.tables.blocks[block_offset+8..block_offset+12].copy_from_slice(&count.to_le_bytes());
+                    let value_offset=root_id as usize*24+8;
+                    self.tables.roots[value_offset..value_offset+4].copy_from_slice(&merged.to_le_bytes());
+                    collapse_roots.insert((row,col),(root_id,merged));
+                    continue;
+                }
+            }
+            let id=self.tables.root(function_id,kind,registers[&value],row,col);
+            if kind==6 { collapse_roots.insert((row,col),(id,register)); }
+            if kind==5 {
+                let parameter=self.parameter_ids.iter().find_map(|(&(p,scope),&i)|(i==row&&scope==col).then_some(p)).ok_or("precision: invalid parameter root")?;
+                if stage==1 {self.model_roots.insert(parameter,id);} else {self.instance_roots.insert(parameter,id);}
+            }
+        }
+        Ok(())
+    }
+    fn callback(&mut self, function_id:u32, _stage:u32, registers:&HashMap<Value,u32>, dst:u32,
+        callback:&CallBackKind, args:&[Value], function:&Function)->Result<(),String> {
+        match callback {
+            CallBackKind::SimParam|CallBackKind::SimParamOpt|CallBackKind::Analysis=> {
+                let name=match args.first().map(|&v|function.dfg.value_def(v)) {
+                    Some(ValueDef::Const(Const::Str(name)))=>self.literals.resolve(&name),
+                    _=>return Err("precision: dynamic system fact name unsupported".into()),
+                };
+                let (offset,len)=self.tables.string(name);
+                if matches!(callback,CallBackKind::Analysis) {
+                    // The fact is Boolean; upstream analysis() returns I32, used
+                    // by original IBCAST conditions and IFCAST arithmetic.
+                    let fact=self.tables.register(3);
+                    self.tables.input(function_id,fact,9,offset,len);
+                    self.tables.instructions.extend(words(&[8,dst,fact,NONE,NONE,0]));
+                }
+                else if args.len()==1 {self.tables.input(function_id,dst,8,offset,len);}
+                else {
+                    let condition=self.tables.register(3);
+                    let supplied=self.tables.register(1);
+                    self.tables.input(function_id,condition,12,offset,len);
+                    self.tables.input(function_id,supplied,8,offset,len);
+                    self.tables.instructions.extend(words(&[74,dst,condition,supplied,registers[&args[1]],0]));
+                }
+            }
+            CallBackKind::CollapseHint(..)=>{},
+            CallBackKind::Print{..}=>{}, // Ordinary admission retains diagnostics; this program owns arithmetic and fatal flags.
+            CallBackKind::SetRetFlag(flag)=> {
+                let status=match flag {hir_lower::RetFlag::Abort=>1,hir_lower::RetFlag::Finish=>2,
+                    hir_lower::RetFlag::Stop=>4,hir_lower::RetFlag::Limited=>8};
+                self.tables.instructions.extend(words(&[73,NONE,status,NONE,NONE,0]));
+            }
+            CallBackKind::ParamInfo(kind,_)=>if matches!(kind,hir_lower::ParamInfoKind::Invalid) {
+                self.tables.instructions.extend(words(&[73,NONE,16,NONE,NONE,0]));
+            },
+            _=>return Err(format!("precision: unsupported live callback {callback:?}, destination {dst}")),
+        }
+        Ok(())
+    }
+}
+
+pub fn serialize(unit:&OsdiCompilationUnit<'_, '_, '_>, precision:&PrecisionModule,
+    literals:&Rodeo, descriptor:u32, profile:[u8;32])->Result<Vec<u8>,String> {
+    if !precision.evaluate.interner.lim_state.is_empty() || !precision.evaluate.interner.absdelay.is_empty() {
+        return Err("precision v1 requires stateless model".into());
+    }
+    let db=unit.db;
+    let mut serializer=Serializer {tables:Tables::default(),db,literals,parameter_ids:HashMap::new(),
+        raw_nodes:HashMap::new(),model_roots:HashMap::new(),instance_roots:HashMap::new(),builtin_parameters:HashMap::new()};
+    for (index,&kind) in unit.module.dae_system.unknowns.iter_enumerated() {
+        serializer.raw_nodes.insert(kind,index.into());
+        let (name,_,_,flow,_,_)=crate::metadata::sim_unknown_info(kind,unit.module.dae_system.residual[index].nature_kind,db);
+        let (o,n)=serializer.tables.string(&name);serializer.tables.nodes.extend(words(&[index.into(),o,n,flow as u32]));
+    }
+    let mut native_index=0u32;
+    for parameter in unit.inst_data.params.keys() {
+        let (name,ty)=match parameter {OsdiInstanceParam::User(p)=>(p.name(db).to_string(),type_id(&p.ty(db))?),
+            OsdiInstanceParam::Builtin(b)=>(format!("${b:?}"),1)};
+        for scope in [1,2] {
+            let index=serializer.tables.parameters.len() as u32/32;
+            let (o,n)=serializer.tables.string(&name);let (flags,default_bits)=match parameter {OsdiInstanceParam::Builtin(kind)=>(1,kind.default_value().to_bits()),_ => (0,0)};
+            serializer.tables.parameters.extend(words(&[native_index,scope,ty,o,n,flags]));
+            serializer.tables.parameters.extend(default_bits.to_le_bytes());
+            match parameter {OsdiInstanceParam::User(p)=>{serializer.parameter_ids.insert((*p,scope),index);},
+                OsdiInstanceParam::Builtin(b)=>{if scope==2 {serializer.builtin_parameters.insert(*b,index);}}}
+        }
+        native_index+=1;
+    }
+    for parameter in unit.model_data.params.keys() {
+        let index=serializer.tables.parameters.len() as u32/32;
+        let (o,n)=serializer.tables.string(&parameter.name(db));
+        serializer.tables.parameters.extend(words(&[native_index,1,type_id(&parameter.ty(db))?,o,n,0]));
+        serializer.tables.parameters.extend(0u64.to_le_bytes());
+        serializer.parameter_ids.insert((*parameter,1),index);native_index+=1;
+    }
+    for (stage,function) in [(1,&precision.model_setup),(2,&precision.instance_setup)] {
+        let mut roots=Vec::new();
+        for (&kind,value) in &function.interner.outputs {
+            if let PlaceKind::Param(p)=kind {if let Some(value)=value.expand() {
+                let index=serializer.parameter(p,stage)?;
+                let scope=if stage==1 {1}else{2};roots.push((5,value,index,scope));
+            }}
+        }
+        serializer.function(stage,function,&roots)?;
+    }
+    let mut roots=Vec::new();
+    for (index,&kind) in precision.dae.unknowns.iter_enumerated() {
+        let row=serializer.node(kind)?;let residual=&precision.dae.residual[index];
+        roots.push((1,residual.resist,row,NONE));roots.push((2,residual.react,row,NONE));
+    }
+    for entry in &precision.dae.jacobian {
+        let row=serializer.node(precision.dae.unknowns[entry.row])?;
+        let col=serializer.node(precision.dae.unknowns[entry.col])?;
+        roots.push((3,entry.resist,row,col));roots.push((4,entry.react,row,col));
+    }
+    for &(hi,lo,value) in &precision.collapse {
+        let hi=serializer.node(hi)?;let lo=lo.map(|kind|serializer.node(kind)).transpose()?.unwrap_or(NONE);
+        roots.push((6,value,hi,lo));
+    }
+    if let Some(value)=precision.evaluate.interner.outputs.get(&PlaceKind::BoundStep).and_then(|v|v.expand()) {
+        roots.push((7,value,NONE,NONE));
+    }
+    serializer.function(3,&precision.evaluate,&roots)?;
+    serializer.tables.finish(descriptor,unit.module.dae_system.unknowns.len() as u32,profile)
+}
+
+pub fn export<'ll>(cx:&mir_llvm::CodegenCx<'_, 'll>, programs:&[Vec<u8>]) {
+    let record=cx.ty_struct("CSOsdiPrecisionExportV1",&[cx.ty_int(),cx.ty_int(),cx.ty_int(),cx.ty_int(),cx.ty_aint(64),cx.ty_ptr()]);
+    let mut records=Vec::new();
+    for (index,program) in programs.iter().enumerate() {
+        let values:Vec<_>=program.iter().map(|&v|cx.const_u8(v)).collect();
+        let address=cx.export_array(&format!("__osdi_precision_program_{index}"),cx.ty_char(),&values,true,false);
+        let bytes=cx.const_usize(program.len());
+        records.push(cx.const_struct(record,&[cx.const_unsigned_int(1),cx.const_unsigned_int(32),
+            cx.const_unsigned_int(index as u32),cx.const_unsigned_int(0),bytes,address]));
+    }
+    cx.export_array("OSDI_PRECISION_V1",record,&records,true,false);
+    cx.export_val("OSDI_PRECISION_V1_COUNT",cx.ty_int(),cx.const_unsigned_int(records.len() as u32),true);
+}
