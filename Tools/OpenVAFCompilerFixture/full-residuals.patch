+    pub(crate) fn retain_preparation_collapse(&mut self) {
+        self.compute_cfg();
+        self.compute_domtree(true, true, true);
+        self.refresh_op_dependent_insts();
+        let rejected: Vec<_> = self.func.layout.blocks().flat_map(|block|
+            self.func.layout.block_insts(block)).filter(|&inst| {
+            self.op_dependent_insts.contains(inst)
+                && matches!(self.func.dfg.insts[inst], InstructionData::Call { func_ref, .. }
+                    if self.intern.callbacks[func_ref].ignore_if_op_dependent())
+        }).collect();
+        for inst in rejected {
+            self.func.dfg.zap_inst(inst);
+            self.func.layout.remove_inst(inst);
+        }
+        for (&kind, value) in &mut self.intern.outputs {
