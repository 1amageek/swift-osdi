+#[test]
+fn full_residuals_preserve_internal_small_signal_contributions() {
+    let src = indoc! {r#"
+        `include "disciplines.vams"
+        module full_residuals(inout p, inout n);
+            electrical p, n, aux;
+            analog begin
+                I(aux) <+ V(aux) + white_noise(1.0);
+                I(aux) <+ ddt((2e-9 + 0.3e-9*V(p,n))*V(aux));
+                I(p,n) <+ (0.1 + 0.2*V(p,n))*V(aux) + ddt(3e-9*V(aux));
+            end
+        endmodule
+    "#};
+    let (_, specialized, _) = compile_with_profile(src, false);
+    assert!(!specialized.small_signal_vals.is_empty());
